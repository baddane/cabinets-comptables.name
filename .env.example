# ============================================================
# VARIABLES D'ENVIRONNEMENT — cabinets-comptables.name V2
# Copiez ce fichier en .env.local et remplissez les valeurs
# NE JAMAIS COMMITTER .env.local dans Git
# ============================================================

# ——— Supabase ———
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre_clé_publique
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre_clé_secrète
SUPABASE_PROJECT_ID=VOTRE_PROJECT_ID

# ——— Email (Resend) ———
RESEND_API_KEY=re_...votre_clé_resend

# ——— Paiement (Stripe) ———
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_PREMIUM_PLUS=price_...

# ——— Sécurité ———
REVALIDATION_SECRET=un_secret_aléatoire_fort

# ——— URLs ———
NEXT_PUBLIC_SITE_URL=https://www.cabinets-comptables.name

# ——— Analytics (optionnel) ———
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
